# Copy to .env and fill in. Only TOKEN is required.

# Bot token from https://discord.com/developers/applications → Bot → Reset Token
TOKEN=

# Your server ID (right-click server icon → Copy Server ID, with Developer Mode on).
# Set this so slash commands appear instantly. Leave blank for global commands.
GUILD_ID=

# --- Channels (defaults are the current Candy SMP channels) ---
# WELCOME_CHANNEL_ID=1448509552541831230
# ROLE_SELECT_CHANNEL_ID=1448580230741495818
# GAME_TEXT_CHANNEL_ID=1476762244380622878
# LEVEL_UP_CHANNEL_ID=        # blank = announce where the user leveled up
# DEALS_CHANNEL_ID=           # or run /deals setup in Discord

# --- Leveling ---
# TEXT_XP_MIN=15
# TEXT_XP_MAX=25
# TEXT_XP_COOLDOWN_SEC=60
# VOICE_XP_PER_MIN=10
# VOICE_MIN_MEMBERS=2         # humans needed in a VC before anyone earns XP
# NO_XP_CHANNEL_IDS=          # comma-separated
# LEVEL_UP_COINS_PER_LEVEL=25

# --- Economy ---
# CURRENCY_NAME=Candy
# CURRENCY_EMOJI=🍬
# STARTING_BALANCE=100
# DAILY_BASE=200
# DAILY_STREAK_BONUS=25
# DAILY_STREAK_CAP=7
# GAMBLE_MAX_BET=5000
# GAMBLE_COOLDOWN_SEC=5

# --- Trivia ---
# TRIVIA_SECONDS=20

# --- Deals ---
# DEALS_CHECK_HOURS=6
# DEALS_COUNTRY=us
# DEALS_MIN_DISCOUNT=1

# Where XP/coins are saved. Default: ./data
# DATA_DIR=
